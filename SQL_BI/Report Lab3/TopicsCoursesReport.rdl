  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>StudentsData</DataSourceName>
        <CommandText>SELECT T.Top_Name, C.Crs_ID, C.Crs_Name
FROM Topic T
JOIN Course C ON T.Top_ID = C.Top_ID
ORDER BY T.Top_Name</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Top_Name">
          <DataField>Top_Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Crs_ID">
          <DataField>Crs_ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Crs_Name">
          <DataField>Crs_Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
