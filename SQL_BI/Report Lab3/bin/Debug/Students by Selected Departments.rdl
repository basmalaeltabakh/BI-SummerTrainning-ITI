  <DataSources>
    <DataSource Name="StudentsData">
      <DataSourceReference>StudentsData</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>af0efe7c-1afa-4cfa-a95f-5066fa04e4eb</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>StudentsData</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@DeptParam">
            <Value>=Parameters!DeptParam.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT S.St_ID, S.St_FName, S.st_age, D.Dept_Name
FROM Student S
JOIN Department D ON S.Dept_ID = D.Dept_ID
WHERE D.Dept_Name IN (@DeptParam)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="St_ID">
          <DataField>St_ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="St_FName">
          <DataField>St_FName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="st_age">
          <DataField>st_age</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Dept_Name">
          <DataField>Dept_Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
