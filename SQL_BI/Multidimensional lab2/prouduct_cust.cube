  <MdxScripts>
    <MdxScript dwd:design-time-name="f2ecd0b9-b9fb-4fe1-8a5c-7fdf918cd4ef">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].Sales_Unit_Price
 AS [Measures].[TotalPrice] / [Measures].[Qty], 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="358912be-dda3-40fc-93b9-81b6df5c9af6">
      <ID>KPI</ID>
      <Name>Qty_KPI</Name>
      <Value>[Measures].[Qty]
</Value>
      <Goal>1000</Goal>
      <Status>case
  when kpivalue("Qty_KPI")&gt;100 then 1 
  when kpivalue ("Qty_KPI")&lt;100 then -1 
  else 0
end

</Status>
      <TrendGraphic>Smiley Face</TrendGraphic>
      <StatusGraphic>Variance Arrow</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>